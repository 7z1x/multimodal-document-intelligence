APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://mdi:mdi@localhost:5432/mdi
STORAGE_DIR=./storage/documents
MAX_UPLOAD_BYTES=15728640
MAX_DOCUMENT_PAGES=10
MAX_IMAGE_PIXELS=40000000
NATIVE_TEXT_MIN_CHARACTERS=40
EXTRACTION_BACKEND=heuristic
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_PROVIDER=opencode
OPENCODE_MODEL=muse-spark-1.3-contributor-free
OPENCODE_TIMEOUT_SECONDS=120
OPENCODE_DIRECTORY=.
MAX_EXTRACTION_CHARACTERS=30000
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.15
AGENT_MAX_RETRIEVAL_ATTEMPTS=2
NEXT_PUBLIC_API_URL=http://localhost:8000
